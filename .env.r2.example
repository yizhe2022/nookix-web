# ============================================
# Cloudflare R2 Configuration (for Presigned URLs)
# ============================================
# 
# 获取这些凭证的步骤：
# 1. 登录 Cloudflare Dashboard: https://dash.cloudflare.com/
# 2. 进入 R2 → 选择你的存储桶
# 3. 点击 "Manage R2 API Tokens"
# 4. 创建新的 API Token（Object Read 权限）
# 5. 复制以下信息并填入下方
#

# Cloudflare Account ID（在 R2 概览页面可以找到）
R2_ACCOUNT_ID=your_account_id_here

# R2 API Token 的 Access Key ID
R2_ACCESS_KEY_ID=your_access_key_id_here

# R2 API Token 的 Secret Access Key
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# R2 存储桶名称（存储音频文件的桶）
R2_BUCKET_NAME=nookix-audio

# ============================================
# 启用/禁用预签名 URL
# ============================================
# 
# 设置为 true：使用预签名 URL（4小时过期，防盗链保护）
# 设置为 false 或不设置：使用直接 URL（当前模式）
#
# 建议：先在本地测试，确认无误后再在生产环境启用
#
NEXT_PUBLIC_USE_PRESIGNED_URL=false

# ============================================
# 注意事项
# ============================================
# 
# 1. 不要将此文件提交到 Git（已在 .gitignore 中）
# 2. 生产环境需要在 Vercel Dashboard 配置相同的环境变量
# 3. 定期轮换 API Token 以提高安全性
# 4. 只授予必要的权限（Object Read）
# 5. 如果遇到问题，设置 NEXT_PUBLIC_USE_PRESIGNED_URL=false 立即回滚
#
